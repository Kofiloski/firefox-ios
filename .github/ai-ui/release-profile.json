{
  "upstream": "mozilla-mobile/firefox-ios",
  "source_seed": "373f4ae9a082155e5953e8595647316dae2631fd",
  "tag_pattern": "^firefox-v(\\d+)\\.(\\d+)(?:\\.(\\d+))?$",
  "project": "firefox-ios/Client.xcodeproj",
  "scheme": "SkillsPublicUI",
  "target": "XCUITests",
  "runner": "scripts/run-release-ui-scenario.sh",
  "build_command": [
    "bash",
    "scripts/skills-build-for-testing.sh"
  ],
  "prepare_commands": [
    [
      "npm",
      "ci",
      "--ignore-scripts"
    ],
    [
      "npm",
      "run",
      "build"
    ]
  ],
  "launch_presets": [
    {
      "action": "launch",
      "arguments": [
        "FIREFOX_TEST",
        "FIREFOX_CLEAR_PROFILE",
        "FIREFOX_SKIP_INTRO",
        "FIREFOX_SKIP_WHATS_NEW",
        "FIREFOX_SKIP_ETP_COVER_SHEET",
        "FIREFOX_SKIP_DEFAULT_BROWSER_ONBOARDING",
        "FIREFOX_SKIP_TERMS_OF_USE",
        "FIREFOX_SKIP_CONTEXTUAL_HINTS",
        "DISABLE_ANIMATIONS",
        "-AppleLanguages",
        "(en)",
        "-AppleLocale",
        "en_US"
      ]
    },
    {
      "action": "launch",
      "arguments": [
        "FIREFOX_TEST",
        "FIREFOX_SKIP_INTRO",
        "FIREFOX_SKIP_WHATS_NEW",
        "FIREFOX_SKIP_ETP_COVER_SHEET",
        "FIREFOX_SKIP_DEFAULT_BROWSER_ONBOARDING",
        "FIREFOX_SKIP_TERMS_OF_USE",
        "FIREFOX_SKIP_CONTEXTUAL_HINTS",
        "DISABLE_ANIMATIONS",
        "-AppleLanguages",
        "(en)",
        "-AppleLocale",
        "en_US"
      ]
    }
  ],
  "max_tests": 3,
  "simulator_name": "iPhone 18 Pro",
  "simulator_runtime": "27.0"
}
